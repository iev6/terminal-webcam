{
  "name": "terminal-webcam",
  "version": "1.0.0",
  "description": "TUI-based live webcam feed viewer for the terminal",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "bun src/index.js",
    "dev": "bun src/index.js",
    "build:native": "bash scripts/build-native.sh",
    "profile": "bun --cpu-prof src/index.js",
    "flamegraph": "bunx speedscope *.cpuprofile"
  },
  "keywords": [
    "webcam",
    "tui",
    "terminal",
    "cli",
    "camera"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "node-webcam": "^0.8.2",
    "sharp": "^0.33.1"
  }
}
